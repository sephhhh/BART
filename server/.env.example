# Copy this file to server/.env and fill it in. server/.env is git-ignored; never commit it.
# These are standard libpq variables, so psql and route_engine.py read them too.

# RDS endpoint: AWS console > RDS > Databases > (your instance) > Connectivity & security > Endpoint
# If you connect through an SSH tunnel from your laptop, use localhost here (see README).
PGHOST=bart-rds.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=bart
PGUSER=BART_MASTER
PGPASSWORD=change-me
# RDS requires SSL. Use disable only for a local Postgres.
PGSSLMODE=require

# Max open database connections held by the API
DB_POOL_SIZE=5
